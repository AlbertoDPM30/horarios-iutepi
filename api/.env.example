# =====================================================================
#  Configuracion de la API - copia este archivo como .env
# =====================================================================

APP_NAME="Horarios IUTEPI"
APP_ENV=local            # local | produccion
APP_DEBUG=true           # ponlo en false al desplegar
APP_TIMEZONE=America/Caracas

# --- Base de datos ---------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=horarios_iutepi
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# --- Autenticacion ---------------------------------------------------
# Genera uno nuevo con:  php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=cambia_esta_clave_por_una_de_al_menos_32_caracteres_aleatorios
JWT_ISSUER=horarios-iutepi
JWT_TTL=28800            # access token: 8 horas
JWT_REFRESH_TTL=604800   # refresh token: 7 dias

# --- CORS ------------------------------------------------------------
# Lista separada por comas. Usa * solo en desarrollo.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Limitador de peticiones ----------------------------------------
RATE_LIMIT_ACTIVO=true
RATE_LIMIT_GENERAL=120   # peticiones por minuto por usuario/IP
RATE_LIMIT_AUTH=8        # intentos de login por minuto por IP
RATE_LIMIT_PESADO=3      # generaciones de horario por minuto

# --- Generador de horarios ------------------------------------------
GENERADOR_INTENTOS=400
GENERADOR_TIEMPO_MAX=20  # segundos

# --- Webhooks --------------------------------------------------------
# Aviso inmediato si se cae la base de datos (no depende de la BD)
WEBHOOK_SISTEMA_URL=
WEBHOOK_TIMEOUT=4
